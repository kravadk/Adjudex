# --- Auto-ingest pipeline (CS2 / Dota2 / football) ---
# Master switch. When =1 the API service runs the match-ingest + resolve
# workers. Off by default. Requires MARKET_CREATOR_PRIVATE_KEY + factory +
# AI judge verifier addresses to actually deploy.
MATCH_INGEST_ENABLED=0
# Force the offline demo feed even if provider tokens are set (great for
# hackathon demos / CI). When unset, real tokens take precedence.
MATCH_FIXTURE_MODE=0
# Provider tokens (optional). No token for a provider -> that provider is
# skipped; with neither esports nor football token, the fixture feed runs.
PANDASCORE_TOKEN=
PANDASCORE_GAMES=cs2,dota2
FOOTBALL_DATA_TOKEN=
# Hot wallet that auto-creates markets + sends propose/finalize txs. SEPARATE
# from DEPLOYER and JUDGE keys; fund with a little Sepolia ETH for gas only.
MARKET_CREATOR_PRIVATE_KEY=
# Worker cadence + deadline padding.
MATCH_INGEST_INTERVAL_MS=300000
MATCH_RESOLVE_INTERVAL_MS=600000
RESULT_BUFFER_SEC=7200
# Optional: path to a custom fixture feed (defaults to services/api/fixtures).
FIXTURE_MATCHES_PATH=
