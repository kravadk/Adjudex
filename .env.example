# --- Auto-ingest pipeline (CS2 / Dota2 / football) ---
# Master switch. When =1 the API service runs the match-ingest + resolve
# workers. Off by default. Requires MARKET_CREATOR_PRIVATE_KEY + factory +
# AI judge verifier addresses to actually deploy.
MATCH_INGEST_ENABLED=0
# Provider tokens (optional). No token for a provider -> that provider is
# skipped; with neither esports nor football token, auto-ingest has no active
# source and does not create markets.
PANDASCORE_TOKEN=
PANDASCORE_GAMES=cs2,dota2
FOOTBALL_DATA_TOKEN=

