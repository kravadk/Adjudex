{
  "name": "arbitrum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "pnpm --filter @adjudex/api dev",
    "dev:indexer": "pnpm --filter @adjudex/indexer dev",
    "api:migrate": "pnpm --filter @adjudex/api migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:compile": "vitest run contracts/__tests__/contracts-compile.test.ts",
    "contracts:abi": "tsx scripts/compile-abis.ts",
    "contracts:deploy": "tsx scripts/deploy-contracts.ts",
    "contracts:register-feeds": "tsx scripts/register-feed.ts",
    "env:check": "tsx scripts/check-env.ts",
    "e2e:live": "tsx scripts/e2e-live.ts",
    "indexer:backfill": "pnpm --filter @adjudex/indexer backfill",
    "serve": "pnpm build && pnpm start",
    "prepare": "husky"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@reclaimprotocol/js-sdk": "^5.4.1",
    "@tanstack/react-query": "^5.100.14",
    "@web3icons/react": "^4.1.17",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.51.0",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "solc": "^0.8.35",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,yml,yaml}": []
  }
}
