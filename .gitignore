# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/deployments/*.json

# misc
.DS_Store
*.pem

# server-local persistence (reclaim proofs cache, dev state)
/.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE / AI-assistant local config
.vscode/
.cursor/
.codex/
.gemini/
.zed/
.mcp.json
opencode.json
AGENTS.md
skills-lock.json

# dev server logs
.next-start.*.log
.next-start.err.log
.next-start.out.log
.next-dev-local-*.log

# scratch / session artifacts
chat-history/

# foundry (forge test) — toolchain deps + build cache, not vendored
/lib/
/cache/
/broadcast/
